# ─────────────────────────────────────────────────────────────────────────────
# Artifex Outreach — environment
#
# Local dev runs in MOCK MODE with none of these set (in-memory store, mock
# providers). PRODUCTION requires DATABASE_URL + secure auth (enforced at startup).
# Never commit real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_APP_URL=https://outreach.artifexlabs.tech
# NODE_ENV is set to "production" automatically on Railway.

# ── Auth (REQUIRED in production) ────────────────────────────────────────────
# Startup fails in production if these are missing or insecure.
OUTREACH_PASSWORD=            # ≥8 chars, not "artifex"/"change-me"
AUTH_SECRET=                  # ≥16 chars random (e.g. `openssl rand -hex 32`)

# ── Database (REQUIRED in production) ────────────────────────────────────────
# Absent → in-memory store (LOCAL DEV / TESTS ONLY). On Railway, reference the
# Postgres service: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=
DB_POOL_MAX=5

# ── AI provider (optional) ───────────────────────────────────────────────────
# AI_PROVIDER: mock | openai | anthropic. Mock is deterministic/offline.
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AI_TIMEOUT_MS=25000

# ── Google Places / Maps / PageSpeed (optional) ──────────────────────────────
# Absent → simulated discovery + heuristic website analysis (clearly labeled).
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_DAILY_CAP=500
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_PAGESPEED_API_KEY=

# ── Durable file storage (optional; S3-compatible: Cloudflare R2 / S3) ────────
# STORAGE_PROVIDER: mock | s3 | r2. Absent/mock → PDFs regenerated on demand.
STORAGE_PROVIDER=mock
S3_ENDPOINT=                  # e.g. https://<account>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=           # optional public base for object URLs

# ── Screenshot worker (optional; Playwright, separate service) ────────────────
SCREENSHOT_WORKER_URL=
SCREENSHOT_WORKER_TOKEN=

# ── Email delivery — Resend (PRODUCTION send path) ───────────────────────────
# This is the real outbound email provider. ABSENT → the email provider is the
# no-op "disabled" provider (nothing can be sent), which is the safe default for
# first run. Set RESEND_API_KEY to enable live sending. RESEND_WEBHOOK_SECRET is
# required for delivery/bounce/complaint/unsubscribe webhooks to be trusted —
# without it, webhooks fail closed in production.
RESEND_API_KEY=               # absent → sending disabled (no live email possible)
RESEND_FROM=                  # verified sender, e.g. "Jordan <jordan@artifexlabs.tech>"
RESEND_WEBHOOK_SECRET=        # Svix signing secret for the Resend webhook (whsec_…)
RESEND_API_BASE=https://api.resend.com
RESEND_TIMEOUT_MS=15000

# ── Gmail send (legacy/alternate; Resend above is the production path) ────────
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# ── Cron / automation auth (REQUIRED to enable scheduled endpoints) ──────────
# Guards /api/cron/* (send, prospect, daily-review) and /api/comms/status.
# ABSENT → those endpoints return 401 (scheduled automation disabled, fail-safe).
# Set a long random value and pass it as a Bearer token from the scheduler.
CRON_SECRET=

# ── Comms queue tuning (optional) ────────────────────────────────────────────
COMMS_MAX_ATTEMPTS=5          # max send attempts before a step is failed
COMMS_STUCK_MS=600000         # ms before a "sending" row is considered stuck + reclaimed

# ── Public base URLs (optional) ──────────────────────────────────────────────
# Used to build absolute links (e.g. one-click unsubscribe). Falls back to
# NEXT_PUBLIC_APP_URL / Railway static URL when unset.
PUBLIC_BASE_URL=
APP_BASE_URL=
APP_URL=

# ── Client agreements — SignWell e-signature (optional; disabled by default) ──
# The master agreement is a DRAFT pending legal review. Live sending is OFF until
# AGREEMENT_SENDING_ENABLED is explicitly true. Without SIGNWELL_API_KEY the e-sign
# provider is a no-op; agreements can still be generated, previewed, and downloaded.
AGREEMENT_SENDING_ENABLED=false   # true|1|yes|on to permit live SignWell + deposit sends
SIGNWELL_API_KEY=                 # X-Api-Key for SignWell
SIGNWELL_WEBHOOK_SECRET=          # HMAC secret for /api/webhooks/signwell (fail-closed in prod)
# SIGNWELL_WEBHOOK_SIGNATURE_HEADER=x-signwell-signature   # override if SignWell changes it
# SIGNWELL_API_BASE=https://www.signwell.com

# ── Deposit collection — Stripe (optional; deposit link only, NOT invoicing) ──
# If unset, the operator pastes a Stripe payment link when sending a deposit.
STRIPE_SECRET_KEY=                # creates a Checkout Session deposit link
STRIPE_WEBHOOK_SECRET=            # verifies /api/webhooks/stripe (fail-closed in prod)

# ── Launch readiness confirmations (optional; operator gates) ────────────────
# Explicit operator acknowledgements surfaced in the Launch readiness checks.
WEBSITE_VERIFIED=false
LAUNCH_MANUAL_REVIEW_CONFIRMED=false

# ── Misc (optional) ──────────────────────────────────────────────────────────
ALLOW_MOCK_PLACES=false       # allow simulated Places results even when a key is set
FORCE_SEED=false              # force re-seed of the demo dataset on boot

# ── Version (optional; Railway injects RAILWAY_GIT_COMMIT_SHA) ────────────────
APP_VERSION=
